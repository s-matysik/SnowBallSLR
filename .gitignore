__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
dist/
build/
_site/
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.hypothesis/
.DS_Store

# Working run directories. `run/` is a live working directory (state, response
# cache, per-iteration exports); `runs/` is the plural form used in the docs.
# A run directory is user data, not source: it is reproducible from seeds and a
# config, and the cache alone runs to megabytes.
run/
runs/
# Live run directories at the repository root (run_llm/ and any sibling arm).
/run_*/

# LICENSED THIRD-PARTY DATA -- must never be redistributed.
# scopus.csv is a raw Scopus export. Elsevier's terms do not permit
# republishing raw records, so this file stays local even though the repository
# is MIT-licensed. Ship a seeds file and a config instead; anyone can regenerate
# their own export.
scopus.csv
*_scopus.csv

# Screening decisions for a specific review -- the author's working data.
labels_*.csv

# Local working copies: the author's real review config and seed set. The
# tracked config.yaml / seeds.txt are neutral templates.
*.local.yaml
*.local.txt

# Internal audit and positioning material, kept out of the public repository:
# the competitor threat assessment and the claim register are working documents
# for manuscript preparation, not part of the software.
# Scopus exports are licensed Elsevier content: the repository is MIT, but these
# are not ours to redistribute. cases/ keeps the DOI-level results derived from
# them, which is what a reader needs to check the analysis.
scopus/
cases/scores_*.json
# Raw cross-vendor scores: keyed to record text derived from the licensed export.
# The derived statistics in cases/xvendor_{validation,agreement,threshold,bibliometric}.json
# are tracked, so a reviewer can check every reported figure without the raw scores.
cases/xvendor_scores.json

# Intermediate candidate pools handed to the screening sub-agents for the narrow run.
# These are working files, superseded by cases/narrow_run.json (the full per-iteration
# record) and llm_screening/narrow_run_outputs/ (PRISMA, included studies, manifest),
# both of which ARE tracked.
llm_screening/narrow?_slice_*.json

# Scratch directory used to pass data between tools during analysis sessions.
handoff/

# Intermediate per-case screening state. These are working files -- batch streams and
# candidate pools -- and some carry record abstracts derived from the licensed Scopus
# export, which cannot be redistributed. The derived per-record scores and every
# reported statistic live in cases/*.json, which IS tracked, so a reviewer can check
# any published figure without them.
llm_screening/case_*/
llm_screening/adverse/

notes/
audit/
AUDIT_INDEX.md
SOFTWAREX_READINESS.md
PUBLISH.md
compass_artifact_*.md
manuscript/

# Local working notes and drafts, kept out of the public repository until they
# are ready.
SECURITY_NOTICE.md
VALIDATION_ROADMAP.md
WORKED_EXAMPLE.md
validation/scopus_third_arm_prototype.py

# Publisher's submission template -- Elsevier's document, not ours to redistribute.
softwarex-osp-template*.docx

# NOTEBOOKS ARE NOT COMMITTED FROM THIS DIRECTORY.
# ewaluator.ipynb contains hard-coded API keys for six providers in its source
# cells AND in its stored outputs. Notebook outputs are a common credential-leak
# route because they survive "clearing the code". Keep notebooks out entirely and
# use the sanitised copies under llm_eval/ instead.
*.ipynb
.ipynb_checkpoints/

# API keys for the cross-vendor validation script -- never committed.
.env
